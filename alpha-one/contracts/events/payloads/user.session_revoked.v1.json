{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user.session_revoked.v1.json",
  "title": "Alpha One — event user.session_revoked v1",
  "description": "V1 catalog event `user.session_revoked` (v1). Envelope per EVT-03. Consumers: AUD (all revocations are audited; AUTH-20/39, AUTH-27 in V2).",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "type": {
          "const": "user.session_revoked"
        },
        "version": {
          "const": 1
        },
        "correlation_id": {
          "$ref": "envelope.schema.json#/$defs/ULID"
        },
        "payload": {
          "type": "object",
          "properties": {
            "identity_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "session_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "reason": {
              "type": "string",
              "enum": [
                "logout",
                "suspension",
                "password_change",
                "reuse_detected",
                "admin_action",
                "concurrency_limit",
                "tenant_suspended"
              ]
            },
            "revoked_by": {
              "type": "string"
            },
            "revoked_at": {
              "$ref": "envelope.schema.json#/$defs/TimestampMs"
            }
          },
          "additionalProperties": false,
          "required": [
            "identity_id",
            "session_id",
            "reason",
            "revoked_at"
          ]
        }
      }
    }
  ]
}
