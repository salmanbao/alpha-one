{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "payout.rejected.v1.json",
  "title": "Alpha One \u2014 event payout.rejected v1",
  "description": "V1 catalog event `payout.rejected` (v1). Envelope per EVT-03 (see envelope.schema.json). Producer/consumers per contracts/events/catalog.md: consumers = NOT-01 (template: payout_rejected \u2014 D61, event-consumed), ANA-01. Derived from: docs/11 \u00a74.1 (payout.rejected) + \u00a73.5 (reject reason required \u2014 taxonomy: insufficient_kyc|risk_review|balance_mismatch|suspicious_method|other:{note}). Money is integer minor units (docs/00 #3); the envelope carries tenant_id \u2014 no redundant tenant field in the payload.",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "type": {
          "const": "payout.rejected"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "payout_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "account_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "amount": {
              "$ref": "envelope.schema.json#/$defs/Money"
            },
            "rejected_by": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "reason": {
              "type": "string",
              "description": "required (payout.reason_required): reason class + note (docs/11 \u00a73.5)"
            },
            "rejected_at": {
              "$ref": "envelope.schema.json#/$defs/TimestampMs"
            }
          },
          "additionalProperties": false,
          "required": [
            "payout_id",
            "account_id",
            "amount",
            "rejected_by",
            "reason",
            "rejected_at"
          ]
        }
      },
      "required": [
        "type",
        "version",
        "payload"
      ]
    }
  ]
}
