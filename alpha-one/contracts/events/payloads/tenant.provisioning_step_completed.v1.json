{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tenant.provisioning_step_completed.v1.json",
  "title": "Alpha One \u2014 event tenant.provisioning_step_completed v1",
  "description": "V1 catalog event `tenant.provisioning_step_completed` (v1). Envelope per EVT-03 (see envelope.schema.json). Producer/consumers per contracts/events/catalog.md: consumers = CON-01 (live view), NOT (staff). Derived from: docs/03 \u00a73.5 (9-step saga) + docs/32 `provisioning_jobs` (current_step, status, error_message, completed_at). Money is integer minor units (docs/00 #3); the envelope carries tenant_id \u2014 no redundant tenant field in the payload.",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "type": {
          "const": "tenant.provisioning_step_completed"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "step": {
              "type": "string",
              "description": "provisioning_jobs.current_step (e.g. step_1_zitadel_org)"
            },
            "status": {
              "type": "string",
              "enum": [
                "succeeded",
                "failed"
              ],
              "description": "provisioning_jobs status on this step"
            },
            "error_message": {
              "type": [
                "string",
                "null"
              ],
              "description": "provisioning_jobs.error_message \u2014 provider-safe, never a secret"
            },
            "completed_at": {
              "$ref": "envelope.schema.json#/$defs/TimestampMs"
            }
          },
          "additionalProperties": false,
          "required": [
            "step",
            "status",
            "completed_at"
          ]
        }
      },
      "required": [
        "type",
        "version",
        "payload"
      ]
    }
  ]
}
