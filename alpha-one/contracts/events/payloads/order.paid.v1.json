{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "order.paid.v1.json",
  "title": "Alpha One \u2014 event order.paid v1",
  "description": "V1 catalog event `order.paid` (v1). Envelope per EVT-03 (see envelope.schema.json). Producer/consumers per contracts/events/catalog.md: consumers = LCC-05 (provisioning), LED-04 (payment capture posting), ANA-01. Payload field values are INFERRED from consumer requirements; the sheet fixes only the envelope (EVT-03) \u2014 field confirmation is an open owner decision (catalog.md).",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "type": {
          "const": "order.paid"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "order_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "challenge_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "size": {
              "type": "string"
            },
            "amount": {
              "$ref": "envelope.schema.json#/$defs/Money"
            },
            "payment_method": {
              "type": "string"
            },
            "provider": {
              "type": "string"
            },
            "provider_event_id": {
              "type": "string"
            },
            "coupon_code": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "order_id",
            "challenge_id",
            "size",
            "amount",
            "payment_method",
            "provider",
            "provider_event_id"
          ]
        }
      },
      "required": [
        "type",
        "version",
        "payload"
      ]
    }
  ]
}
