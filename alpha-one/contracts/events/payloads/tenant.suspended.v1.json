{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tenant.suspended.v1.json",
  "title": "Alpha One \u2014 event tenant.suspended v1",
  "description": "V1 catalog event `tenant.suspended` (v1). Envelope per EVT-03. Consumers: AUTH (kill sessions), GW (deny), NOT (owner), AUD \u2014 all stop within 1 s (TEN-15).",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "type": {
          "const": "tenant.suspended"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "tenant_id_ref": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "reason_code": {
              "type": "string",
              "enum": [
                "billing",
                "abuse",
                "risk",
                "manual",
                "provider"
              ]
            },
            "reason_text": {
              "type": "string"
            },
            "actor": {
              "type": "string"
            },
            "suspended_at": {
              "$ref": "envelope.schema.json#/$defs/TimestampMs"
            }
          },
          "additionalProperties": false,
          "required": [
            "tenant_id_ref",
            "reason_code",
            "suspended_at"
          ]
        }
      }
    }
  ]
}
