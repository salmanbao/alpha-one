{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user.login_success.v1.json",
  "title": "Alpha One \u2014 event user.login_success v1",
  "description": "V1 catalog event `user.login_success` (v1). Envelope per EVT-03. Consumers: AUD, ANA, RSK (anomaly baseline). Origin is ZITADEL (Actions v2 event trigger) or our session materialisation \u2014 same field set either way.",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "type": {
          "const": "user.login_success"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "identity_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "session_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "amr": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "authentication methods (pwd, otp, webauthn)"
            },
            "mfa": {
              "type": "boolean"
            },
            "ip": {
              "type": "string"
            },
            "user_agent": {
              "type": "string"
            },
            "logged_in_at": {
              "$ref": "envelope.schema.json#/$defs/TimestampMs"
            }
          },
          "additionalProperties": false,
          "required": [
            "identity_id",
            "session_id",
            "amr",
            "logged_in_at"
          ]
        }
      }
    }
  ]
}
