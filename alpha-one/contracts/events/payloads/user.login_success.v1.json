{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user.login_success.v1.json",
  "title": "Alpha One \u2014 event user.login_success v1",
  "description": "V1 catalog event `user.login_success` (v1). Envelope per EVT-03 (see envelope.schema.json). Producer/consumers per contracts/events/catalog.md: consumers = AUD, ANA-01, RSK (anomaly baseline). Derived from: docs/02 \u00a74.1 (user.login_success, session materialisation) + docs/32 `auth_sessions` (id, amr, ip/ua per the \u00a74.1 note). Money is integer minor units (docs/00 #3); the envelope carries tenant_id \u2014 no redundant tenant field in the payload.",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "type": {
          "const": "user.login_success"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "identity_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "session_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "amr": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "auth_sessions.amr (authentication methods)"
            },
            "mfa": {
              "type": "boolean"
            },
            "ip": {
              "type": "string"
            },
            "user_agent": {
              "type": "string"
            },
            "logged_in_at": {
              "$ref": "envelope.schema.json#/$defs/TimestampMs"
            }
          },
          "additionalProperties": false,
          "required": [
            "identity_id",
            "session_id",
            "amr",
            "logged_in_at"
          ]
        }
      },
      "required": [
        "type",
        "version",
        "payload"
      ]
    }
  ]
}
