{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Resumed.v1.json",
  "title": "Alpha One \u2014 event Resumed v1",
  "description": "V1 catalog event `Resumed` (v1). Envelope per EVT-03 (see envelope.schema.json). Producer/consumers per contracts/events/catalog.md: consumers = ANA-01. Derived from: docs/07 \u00a73.2 (SUSPENDED\u2192ACTIVE/FUNDED rows: 'BRG-14 enable; Resumed (LCC-23)'). Money is integer minor units (docs/00 #3); the envelope carries tenant_id \u2014 no redundant tenant field in the payload.",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "type": {
          "const": "Resumed"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "account_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "actor_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "resumed_at": {
              "$ref": "envelope.schema.json#/$defs/TimestampMs"
            }
          },
          "additionalProperties": false,
          "required": [
            "account_id",
            "actor_id",
            "resumed_at"
          ]
        }
      },
      "required": [
        "type",
        "version",
        "payload"
      ]
    }
  ]
}
