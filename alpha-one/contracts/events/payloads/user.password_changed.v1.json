{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user.password_changed.v1.json",
  "title": "Alpha One — event user.password_changed v1",
  "description": "V1 catalog event `user.password_changed` (v1). Envelope per EVT-03. Consumers: session invalidator (all other sessions), AUD (compliance). Never carries the password or its hash.",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "type": {
          "const": "user.password_changed"
        },
        "version": {
          "const": 1
        },
        "correlation_id": {
          "$ref": "envelope.schema.json#/$defs/ULID"
        },
        "payload": {
          "type": "object",
          "properties": {
            "identity_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "method": {
              "type": "string",
              "enum": [
                "self_service",
                "reset_link",
                "admin_reset",
                "migration"
              ]
            },
            "other_sessions_revoked": {
              "type": "integer",
              "minimum": 0
            },
            "changed_at": {
              "$ref": "envelope.schema.json#/$defs/TimestampMs"
            }
          },
          "additionalProperties": false,
          "required": [
            "identity_id",
            "method",
            "changed_at"
          ]
        }
      }
    }
  ]
}
