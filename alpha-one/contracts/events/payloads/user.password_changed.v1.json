{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "user.password_changed.v1.json",
  "title": "Alpha One \u2014 event user.password_changed v1",
  "description": "V1 catalog event `user.password_changed` (v1). Envelope per EVT-03 (see envelope.schema.json). Producer/consumers per contracts/events/catalog.md: consumers = session invalidator, AUD. Derived from: docs/02 \u00a74.1 (user.password_changed, AUTH-05/AUTH-40; credential change kills other sessions \u2014 review G40). Money is integer minor units (docs/00 #3); the envelope carries tenant_id \u2014 no redundant tenant field in the payload.",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "type": {
          "const": "user.password_changed"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "identity_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "method": {
              "type": "string",
              "description": "self|admin_reset|migration_reset"
            },
            "other_sessions_revoked": {
              "type": "integer",
              "minimum": 0
            },
            "changed_at": {
              "$ref": "envelope.schema.json#/$defs/TimestampMs"
            }
          },
          "additionalProperties": false,
          "required": [
            "identity_id",
            "method",
            "changed_at"
          ]
        }
      },
      "required": [
        "type",
        "version",
        "payload"
      ]
    }
  ]
}
