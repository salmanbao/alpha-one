{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Suspended.v1.json",
  "title": "Alpha One \u2014 event Suspended v1",
  "description": "V1 catalog event `Suspended` (v1). Envelope per EVT-03 (see envelope.schema.json). Producer/consumers per contracts/events/catalog.md: consumers = PAY-04 (payout hold while open), ANA-01. Payload field values are INFERRED from consumer requirements; the sheet fixes only the envelope (EVT-03) \u2014 field confirmation is an open owner decision (catalog.md).",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "type": {
          "const": "Suspended"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "account_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "actor_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "reason": {
              "type": "string"
            },
            "suspended_at": {
              "$ref": "envelope.schema.json#/$defs/TimestampMs"
            }
          },
          "additionalProperties": false,
          "required": [
            "account_id",
            "actor_id",
            "reason",
            "suspended_at"
          ]
        }
      },
      "required": [
        "type",
        "version",
        "payload"
      ]
    }
  ]
}
