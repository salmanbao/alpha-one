{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AccountPassed.v1.json",
  "title": "Alpha One \u2014 event AccountPassed v1",
  "description": "V1 catalog event `AccountPassed` (v1). Envelope per EVT-03 (see envelope.schema.json). Producer/consumers per contracts/events/catalog.md: consumers = NOT-01 (template: phase passed), DOC-04 (certificate), ANA-01. Derived from: docs/07 \u00a73.2 (PASS/VERIFICATION rows emit 'AccountPassed (LCC-23)'); docs/32 `accounts` (id, identity_id\u2192trader_id, program_id); docs/14 \u00a73.4 (phase_passed template). Money is integer minor units (docs/00 #3); the envelope carries tenant_id \u2014 no redundant tenant field in the payload.",
  "allOf": [
    {
      "$ref": "envelope.schema.json#/$defs/envelope"
    },
    {
      "properties": {
        "type": {
          "const": "AccountPassed"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "properties": {
            "account_id": {
              "$ref": "envelope.schema.json#/$defs/ULID"
            },
            "trader_id": {
              "$ref": "envelope.schema.json#/$defs/ULID",
              "description": "accounts.identity_id"
            },
            "challenge_id": {
              "$ref": "envelope.schema.json#/$defs/ULID",
              "description": "accounts.program_id"
            },
            "phase": {
              "type": "integer",
              "minimum": 1
            },
            "passed_at": {
              "$ref": "envelope.schema.json#/$defs/TimestampMs"
            }
          },
          "additionalProperties": false,
          "required": [
            "account_id",
            "trader_id",
            "challenge_id",
            "phase",
            "passed_at"
          ]
        }
      },
      "required": [
        "type",
        "version",
        "payload"
      ]
    }
  ]
}
