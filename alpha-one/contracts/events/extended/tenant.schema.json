{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alphaone://events/tenant",
  "title": "Alpha One events (extended) \u2014 topic `tenant.*`",
  "description": "Extended (post-V1) schemas for the `tenant.*` event topic \u2014 the design-level set beyond the V1 execution-sheet baseline (contracts/events/catalog.md + payloads/). Envelope per EVT-03. Catalog + producer/consumer map: docs/31-event-catalog.md. Transport: Redis Streams at-least-once + idempotent consumers (docs/04 \u00a75); webhook egress via Hook0 (docs/04 \u00a75.6).",
  "$defs": {
    "EventEnvelope": {
      "type": "object",
      "required": [
        "id",
        "type",
        "version",
        "tenant_id",
        "occurred_at",
        "payload"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "occurred_at": {
          "type": "integer",
          "format": "int64"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "tenant_created": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tenant.created"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 03 (TEN). When: TEN-01. Consumers: AUD, CON, NOT (owner). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "tenant_member_invited": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tenant.member_invited"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 03 (TEN). When: AUTH-03 (V2 row, V1 SSO-tenant exception). Consumers: NOT, CON. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "tenant_provisioning_step_completed": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tenant.provisioning_step_completed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 03 (TEN). When: TEN (orchestrator, docs/03 \u00a73.5). Consumers: CON (live view), NOT (staff). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "tenant_activated": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tenant.activated"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 03 (TEN). When: TEN (checklist complete). Consumers: GW (allow traffic), NOT (owner), AUD, ANA. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "tenant_suspended": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tenant.suspended"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 03 (TEN). When: TEN-15. Consumers: AUTH (kill sessions), GW (deny), NOT (owner), AUD \u2014 **all stop within 1 s**. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "tenant_reactivated": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tenant.reactivated"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 03 (TEN). When: TEN-15. Consumers: GW, NOT, AUD, AUTH (identities stay active; sessions require a new login). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "tenant_plan_changed": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tenant.plan_changed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 03 (TEN). When: plan/entitlement edit. Consumers: Flipt sync, limits revalidate, AUD. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "tenant_settings_changed": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tenant.settings_changed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 03 (TEN). When: settings JSONB edited. Consumers: cache invalidator (t:{id}:*), AUD (before/after diff). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "tenant_branding_changed": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tenant.branding_changed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 03 (TEN). When: logo/colours/texts edited. Consumers: web (cache bust), DOC/NOT (next render), AUD. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "tenant_deletion_scheduled": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tenant.deletion_scheduled"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 03 (TEN). When: termination saga (\u00a75.2). Consumers: CON, AUD, MIG (blocks cutover). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "tenant_deactivated": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tenant.deactivated"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 03 (TEN). When: recovery window (TEN-45, V2). Consumers: GW, AUTH, NOT, AUD. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "tenant_limit_exceeded": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tenant.limit_exceeded"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 03 (TEN). When: enforcer warning at 80%, hard stop at 100%. Consumers: NOT (owner), ANA. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "tenant_entitlement_changed": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "tenant.entitlement_changed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 03 (TEN). When: module on/off. Consumers: GW (route gating), Flipt, AUD (TEN-08). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/tenant_created"
    },
    {
      "$ref": "#/$defs/tenant_member_invited"
    },
    {
      "$ref": "#/$defs/tenant_provisioning_step_completed"
    },
    {
      "$ref": "#/$defs/tenant_activated"
    },
    {
      "$ref": "#/$defs/tenant_suspended"
    },
    {
      "$ref": "#/$defs/tenant_reactivated"
    },
    {
      "$ref": "#/$defs/tenant_plan_changed"
    },
    {
      "$ref": "#/$defs/tenant_settings_changed"
    },
    {
      "$ref": "#/$defs/tenant_branding_changed"
    },
    {
      "$ref": "#/$defs/tenant_deletion_scheduled"
    },
    {
      "$ref": "#/$defs/tenant_deactivated"
    },
    {
      "$ref": "#/$defs/tenant_limit_exceeded"
    },
    {
      "$ref": "#/$defs/tenant_entitlement_changed"
    }
  ]
}
