{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alphaone://events/migration",
  "title": "Alpha One events (extended) \u2014 topic `migration.*`",
  "description": "Extended (post-V1) schemas for the `migration.*` event topic \u2014 the design-level set beyond the V1 execution-sheet baseline (contracts/events/catalog.md + payloads/). Envelope per EVT-03. Catalog + producer/consumer map: docs/31-event-catalog.md. Transport: Redis Streams at-least-once + idempotent consumers (docs/04 \u00a75); webhook egress via Hook0 (docs/04 \u00a75.6).",
  "$defs": {
    "EventEnvelope": {
      "type": "object",
      "required": [
        "id",
        "type",
        "version",
        "tenant_id",
        "occurred_at",
        "payload"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "occurred_at": {
          "type": "integer",
          "format": "int64"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "migration_started": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "migration.started"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 25 (MIG). When: import begins (class). Consumers: CON (ops), AUD (critical). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "migration_class_completed": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "migration.class_completed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 25 (MIG). When: a data class lands (counts, exceptions). Consumers: CON, AUD. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "migration_reconciled": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "migration.reconciled"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 25 (MIG). When: the report (match rate, exceptions). Consumers: CON (the cutover gate reads it), AUD (critical). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "migration_exception_dispositioned": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "migration.exception_dispositioned"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 25 (MIG). When: an exception is dispositioned (2FA'd). Consumers: AUD (critical). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "migration_cutover_complete": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "migration.cutover_complete"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 25 (MIG). When: T_date flip done. Consumers: CON, AUD (critical \u2014 the platform's biggest audit event of the year). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "migration_parallel_drift": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "migration.parallel_drift"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 25 (MIG). When: the daily comparator exceeds 1\u00a2. Consumers: CON (P1), NOT (ops), AUD (critical). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "migration_closed": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "migration.closed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 25 (MIG). When: parallel run signed. Consumers: CON, AUD. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/migration_started"
    },
    {
      "$ref": "#/$defs/migration_class_completed"
    },
    {
      "$ref": "#/$defs/migration_reconciled"
    },
    {
      "$ref": "#/$defs/migration_exception_dispositioned"
    },
    {
      "$ref": "#/$defs/migration_cutover_complete"
    },
    {
      "$ref": "#/$defs/migration_parallel_drift"
    },
    {
      "$ref": "#/$defs/migration_closed"
    }
  ]
}
