{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alphaone://events/kyc",
  "title": "Alpha One events (extended) \u2014 topic `kyc.*`",
  "description": "Extended (post-V1) schemas for the `kyc.*` event topic \u2014 the design-level set beyond the V1 execution-sheet baseline (contracts/events/catalog.md + payloads/). Envelope per EVT-03. Catalog + producer/consumer map: docs/31-event-catalog.md. Transport: Redis Streams at-least-once + idempotent consumers (docs/04 \u00a75); webhook egress via Hook0 (docs/04 \u00a75.6).",
  "$defs": {
    "EventEnvelope": {
      "type": "object",
      "required": [
        "id",
        "type",
        "version",
        "tenant_id",
        "occurred_at",
        "payload"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "occurred_at": {
          "type": "integer",
          "format": "int64"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "kyc_submitted": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "kyc.submitted"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 13 (KYC). When: KYC-05 (webhook status handling), KYC-16. Consumers: NOT-01 (template: KYC result), ANA-01. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "kyc_approved": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "kyc.approved"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 13 (KYC). When: KYC-05, KYC-16. Consumers: NOT-01, LCC-06 (auto-upgrade on approval), PAY-03 (payout eligibility), ANA-01. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "kyc_rejected": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "kyc.rejected"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 13 (KYC). When: KYC-05, KYC-16. Consumers: NOT-01, ANA-01. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "kyc_expired": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "kyc.expired"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 13 (KYC). When: KYC-05, KYC-16. Consumers: NOT-01, ANA-01 \u2014 EXPIRED trigger is an open question. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "kyc_resubmission_requested": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "kyc.resubmission_requested"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 13 (KYC). When: KYC-05, KYC-16. Consumers: NOT-01, ANA-01. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "kyc_session_started": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "kyc.session_started"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 13 (KYC). When: session created (level). Consumers: AUD, ANA (funnel). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "kyc_status_changed": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "kyc.status_changed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 17 (ADM). When: KYC queue. Consumers: KYC queue. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "kyc_verified": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "kyc.verified"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 13 (KYC). When: level verified (record ref). Consumers: CHK (gate unblock notification), PAY (gate), ANA, AUD. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "kyc_manual_review_requested": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "kyc.manual_review_requested"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 13 (KYC). When: provider undecided \u2192 queue. Consumers: NOT (staff), AUD. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "kyc_gate_blocked": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "kyc.gate_blocked"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 13 (KYC). When: a gated action failed on KYC. Consumers: ANA (drop-off funnel), NOT (trader \"complete your verification\"). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "kyc_consent_recorded": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "kyc.consent_recorded"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 13 (KYC). When: consent captured. Consumers: AUD (compliance). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/kyc_submitted"
    },
    {
      "$ref": "#/$defs/kyc_approved"
    },
    {
      "$ref": "#/$defs/kyc_rejected"
    },
    {
      "$ref": "#/$defs/kyc_expired"
    },
    {
      "$ref": "#/$defs/kyc_resubmission_requested"
    },
    {
      "$ref": "#/$defs/kyc_session_started"
    },
    {
      "$ref": "#/$defs/kyc_status_changed"
    },
    {
      "$ref": "#/$defs/kyc_verified"
    },
    {
      "$ref": "#/$defs/kyc_manual_review_requested"
    },
    {
      "$ref": "#/$defs/kyc_gate_blocked"
    },
    {
      "$ref": "#/$defs/kyc_consent_recorded"
    }
  ]
}
