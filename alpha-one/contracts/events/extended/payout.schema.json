{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alphaone://events/payout",
  "title": "Alpha One events (extended) \u2014 topic `payout.*`",
  "description": "Extended (post-V1) schemas for the `payout.*` event topic \u2014 the design-level set beyond the V1 execution-sheet baseline (contracts/events/catalog.md + payloads/). Envelope per EVT-03. Catalog + producer/consumer map: docs/31-event-catalog.md. Transport: Redis Streams at-least-once + idempotent consumers (docs/04 \u00a75); webhook egress via Hook0 (docs/04 \u00a75.6).",
  "$defs": {
    "EventEnvelope": {
      "type": "object",
      "required": [
        "id",
        "type",
        "version",
        "tenant_id",
        "occurred_at",
        "payload"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "occurred_at": {
          "type": "integer",
          "format": "int64"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "payout_approved": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "payout.approved"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 11 (PAY). When: PAY-09. Consumers: LED-07 (payout obligation posting), NOT-01 (template: payout approved), ANA-01. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "payout_rejected": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "payout.rejected"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 11 (PAY). When: PAY-09. Consumers: NOT-01 (template: payout rejected), ANA-01. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "payout_requested": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "payout.requested"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 11 (PAY). When: request created (eligible). Consumers: NOT (trader + finance), ANA. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "payout_eligibility_failed": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "payout.eligibility_failed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 11 (PAY). When: request rejected at validation. Consumers: NOT (trader, reason template). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "payout_execution_attempted": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "payout.execution_attempted"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 11 (PAY). When: each send/retry. Consumers: AUD. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "payout_failed": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "payout.failed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 11 (PAY). When: rail failure. Consumers: NOT (on final), ADM, AUD. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "payout_cancelled": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "payout.cancelled"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 11 (PAY). When: trader cancel (pre-approval). Consumers: NOT, ANA. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "payout_hold_set": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "payout.hold_set"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 11 (PAY). When: RSK interplay (V2). Consumers: AUD. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "payout_reconciled": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "payout.reconciled"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 11 (PAY). When: nightly. Consumers: ADM, CON, AUD. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "payout_status_changed": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "payout.status_changed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 17 (ADM). When: queue live update + badge. Consumers: queue live update + badge. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/payout_approved"
    },
    {
      "$ref": "#/$defs/payout_rejected"
    },
    {
      "$ref": "#/$defs/payout_requested"
    },
    {
      "$ref": "#/$defs/payout_eligibility_failed"
    },
    {
      "$ref": "#/$defs/payout_execution_attempted"
    },
    {
      "$ref": "#/$defs/payout_failed"
    },
    {
      "$ref": "#/$defs/payout_cancelled"
    },
    {
      "$ref": "#/$defs/payout_hold_set"
    },
    {
      "$ref": "#/$defs/payout_reconciled"
    },
    {
      "$ref": "#/$defs/payout_status_changed"
    }
  ]
}
