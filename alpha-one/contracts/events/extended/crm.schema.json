{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "alphaone://events/crm",
  "title": "Alpha One events (extended) \u2014 topic `crm.*`",
  "description": "Extended (post-V1) schemas for the `crm.*` event topic \u2014 the design-level set beyond the V1 execution-sheet baseline (contracts/events/catalog.md + payloads/). Envelope per EVT-03. Catalog + producer/consumer map: docs/31-event-catalog.md. Transport: Redis Streams at-least-once + idempotent consumers (docs/04 \u00a75); webhook egress via Hook0 (docs/04 \u00a75.6).",
  "$defs": {
    "EventEnvelope": {
      "type": "object",
      "required": [
        "id",
        "type",
        "version",
        "tenant_id",
        "occurred_at",
        "payload"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "type": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "tenant_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "occurred_at": {
          "type": "integer",
          "format": "int64"
        },
        "payload": {
          "type": "object"
        }
      }
    },
    "crm_segment_recomputed": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "crm.segment_recomputed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 20 (CRM). When: 15-min cadence / manual. Consumers: AUD (low). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "crm_campaign_sent": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "crm.campaign_sent"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 20 (CRM). When: batch dispatched to NOT. Consumers: NOT (the actual sends), ANA (CRM-08 inputs), AUD (critical: marketing sends are tenant-visible). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "crm_sequence_advanced": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "crm.sequence_advanced"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 20 (CRM). When: step engine. Consumers: AUD (low). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "crm_consent_changed": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "crm.consent_changed"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 20 (CRM). When: capture/unsubscribe/withdrawal. Consumers: NOT (suppression list), AUD (critical). Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    },
    "crm_unsubscribe": {
      "allOf": [
        {
          "$ref": "#/$defs/EventEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "crm.unsubscribe"
            },
            "payload": {
              "type": "object",
              "additionalProperties": true,
              "description": "Per-event payload. Producer: 20 (CRM). When: link clicked. Consumers: NOT, AUD. Canonical fields: the producer module doc's \u00a74/\u00a78 (docs/31)."
            }
          }
        }
      ]
    }
  },
  "anyOf": [
    {
      "$ref": "#/$defs/crm_segment_recomputed"
    },
    {
      "$ref": "#/$defs/crm_campaign_sent"
    },
    {
      "$ref": "#/$defs/crm_sequence_advanced"
    },
    {
      "$ref": "#/$defs/crm_consent_changed"
    },
    {
      "$ref": "#/$defs/crm_unsubscribe"
    }
  ]
}
