{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alpha1.io/contracts/tenants/tenant-settings.schema.json",
  "title": "Alpha One tenant settings (curated keys)",
  "description": "Validation schema for `tenants.settings` JSONB (docs/03 §3.3). Enforced on every write: PATCH /v1/settings (V1.1) and the console edit path. Unknown keys are rejected (`additionalProperties: false` at every level); secrets are FORBIDDEN here — tenant-supplied credentials live in `integration_config` (TEN-11/12, docs/03 §3.7). V2 curated keys (`terminology.*`, `locale`, `comms.channels`) join at their module freeze (docs/99 §12) and are intentionally absent so a V1 write cannot smuggle them in. This file is the contract the schema test renders into the tenant docs page (docs/03 §16 risks row).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "trading": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_leverage": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "supported_symbols": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^[A-Z0-9]{2,20}$" },
          "description": "Override of the broker group's symbol list (BRG-12)."
        },
        "broker_group": { "type": "string", "maxLength": 100, "description": "MetaApi server-group reference (BRG-12)." }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default_phases": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["phase1", "phase2", "phase3", "verification", "funded"] }
        },
        "auto_fund_on_pass": { "type": "boolean", "description": "V1 per-tenant default; an EVL rule pack may override per challenge." }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "restricted_countries": { "$ref": "#/$defs/countryList" },
        "require_kyc_before_funding": { "type": "boolean" }
      }
    },
    "payout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_amount_cents": { "type": "integer", "minimum": 0 },
        "currency": { "$ref": "#/$defs/currency" },
        "approval_mode": { "type": "string", "enum": ["manual", "auto"], "description": "The API-key channel never auto-approves regardless of this setting (docs/27 §3.1, A10)." },
        "min_trades": { "type": "integer", "minimum": 0 },
        "first_payout_delay_days": { "type": "integer", "minimum": 0, "maximum": 365 },
        "methods": {
          "type": "array",
          "items": { "type": "string", "enum": ["crypto", "bank_transfer"] }
        }
      }
    },
    "kyc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": { "type": "boolean" },
        "provider": { "type": "string", "enum": ["veriff"], "description": "V1 signed provider (docs/00 §6); the enum widens only via a BVR change (docs/34)." },
        "reverify_days": { "type": "integer", "minimum": 30, "maximum": 1095 }
      }
    },
    "comms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "email_from": { "type": "string", "format": "idn-email", "description": "Sender identity on the tenant's verified sending domain (TEN-14 DNS records are V1.1)." },
        "email_reply_to": { "type": "string", "format": "idn-email" },
        "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$", "default": "en" },
        "telegram_channel": { "type": "string", "maxLength": 100, "description": "V2 (TEN-31 surface)." }
      }
    },
    "legal": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "terms_url": { "$ref": "#/$defs/httpsUrl" },
        "privacy_url": { "$ref": "#/$defs/httpsUrl" },
        "risk_disclosure_url": { "$ref": "#/$defs/httpsUrl" },
        "refund_policy_url": { "$ref": "#/$defs/httpsUrl" }
      }
    },
    "geo": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_countries": { "$ref": "#/$defs/countryListNullable" },
        "restricted_countries": { "$ref": "#/$defs/countryList" }
      }
    }
  },
  "$defs": {
    "countryList": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[A-Z]{2}$" },
      "uniqueItems": true
    },
    "countryListNullable": {
      "description": "null = all countries allowed (docs/03 §3.3 geo.allowed_countries).",
      "anyOf": [ { "type": "null" }, { "$ref": "#/$defs/countryList" } ]
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "httpsUrl": {
      "type": "string",
      "pattern": "^https://[A-Za-z0-9.-]+(:[0-9]{2,5})?(/[^\\s]*)?$",
      "description": "Legal URLs must be https and tenant-owned (or the platform default) — docs/03 §10, no arbitrary redirect hosting."
    }
  }
}
